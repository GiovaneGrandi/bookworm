@@ -94,6 +94,20 @@ abstract class BaseReaderFragment : Fragment() {
     startSelectionMonitoring()
   }
 
+  // BookWorm: o `progression` do Readium é fração do layout, não do texto; num recurso com
+  // páginas de imagem (capa, folha de rosto) a mesma fração cai noutro trecho quando o corpo
+  // muda. Com o texto do primeiro elemento visível no locator, o `goTo` reposiciona pelo trecho
+  // (TextQuoteAnchor do Readium) e um ajuste do painel não move a leitora (RN-02.16e).
+  @OptIn(org.readium.r2.shared.ExperimentalReadiumApi::class)
+  private suspend fun comTextoVisivel(
+    locator: org.readium.r2.shared.publication.Locator
+  ): org.readium.r2.shared.publication.Locator {
+    val visual = navigator as? org.readium.r2.navigator.VisualNavigator ?: return locator
+    val primeiro = runCatching { visual.firstVisibleElementLocator() }.getOrNull() ?: return locator
+    if (primeiro.href != locator.href || primeiro.text.highlight.isNullOrBlank()) return locator
+    return locator.copy(text = primeiro.text)
+  }
+
